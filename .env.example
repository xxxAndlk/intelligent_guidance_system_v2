# ============================================
# 基础设施配置
# ============================================

# MySQL 8.0.X
MYSQL_ROOT_PASSWORD=root123
MYSQL_USER=medical
MYSQL_PASSWORD=medical123
MYSQL_DATABASE=medical_system
MYSQL_PORT=3306

# Redis 7.4.X
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PORT=6379
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE=5
REDIS_MAX_RETRIES=3

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASS=admin123
RABBITMQ_VHOST=medical
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Consul
CONSUL_HTTP_PORT=8500
CONSUL_GRPC_PORT=8600

# ============================================
# AI服务配置
# ============================================

# SiliconFlow API（必填）
SILICONFLOW_API_KEY=sk-your-api-key-here

# DeepSeek API（可选）
DEEPSEEK_API_KEY=${SILICONFLOW_API_KEY}

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# JWT配置
# ============================================
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# ============================================
# 服务配置
# ============================================
SERVICE_ENV=development
SERVICE_REGION=default
